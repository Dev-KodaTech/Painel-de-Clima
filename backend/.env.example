# Copie para `.env` e ajuste. O `.env` real nao entra no git.
#
# Estes sao os valores de desenvolvimento, iguais aos do `compose.yaml` na
# raiz do projeto. Ambos tem padrao no codigo, entao um `.env` vazio funciona
# em dev; o arquivo existe para documentar o que muda em producao.

# A URL do banco. O esquema precisa ser `postgresql+psycopg://` — o driver e o
# psycopg 3, e sem o sufixo o SQLAlchemy procura o psycopg2.
DATABASE_URL=postgresql+psycopg://painel:painel@localhost:5433/painel

# Origens permitidas pelo CORS, separadas por virgula. Vazio em dev, onde o
# proxy do Vite faz o browser ver uma origem so.
CORS_ORIGINS=

# Opcional, e **nao** usada pela aplicacao: so pelos testes marcados com
# `postgres`, que criam e destroem o banco que ela aponta. Tem URL propria, e
# nao reusa DATABASE_URL, justamente para que rodar os testes nunca possa
# apagar um banco de verdade.
# DATABASE_URL_DE_TESTE=postgresql+psycopg://painel:painel@localhost:5433/painel_teste
